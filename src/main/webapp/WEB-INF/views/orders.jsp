<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html><head><title>Заказы</title><link rel="stylesheet" href="${pageContext.request.contextPath}/style.css"></head><body><nav><a href="${pageContext.request.contextPath}/products">Товары</a><a href="${pageContext.request.contextPath}/profile">Профиль</a><a href="${pageContext.request.contextPath}/logout">Выйти</a></nav><main><h1>Мои заказы</h1><p class="error">${error}</p><c:forEach var="o" items="${orders}"><article class="card"><h2>Заказ #${o.id}</h2><p>Товар: ${o.productName}</p><p>Количество: ${o.quantity}</p><p>Сумма: ${o.totalPrice} ₽</p><p>Статус: ${o.status}</p><c:if test="${o.status == 'CREATED'}"><form action="${pageContext.request.contextPath}/orders" method="post"><input type="hidden" name="action" value="cancel"><input type="hidden" name="id" value="${o.id}"><button class="danger">Отменить</button></form></c:if></article></c:forEach></main></body></html>